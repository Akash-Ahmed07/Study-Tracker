{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private student settings, grading scale preference, and weekly study goal.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "gradingScale": { "type": "string", "enum": ["bd", "us"] },
        "weeklyGoalMinutes": { "type": "number" },
        "friendCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "priorCgpa": { "type": "number" },
        "priorCredits": { "type": "number" },
        "suspended": { "type": "boolean" },
        "suspendedReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "gradingScale", "weeklyGoalMinutes", "friendCode", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Private university course record including credits and optional private grade.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "semester": { "type": "string", "minLength": 1, "maxLength": 40 },
        "credits": { "type": "number" },
        "gradeLetter": { "type": "string", "maxLength": 8 },
        "isCompleted": { "type": "boolean" },
        "color": { "type": "string", "maxLength": 24 },
        "midtermScore": { "type": "number" },
        "midtermMax": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "code", "title", "semester", "credits", "gradeLetter", "isCompleted", "color", "createdAt", "updatedAt"]
    },
    "SyllabusTopic": {
      "title": "SyllabusTopic",
      "description": "Syllabus topic attached to a course with todo/doing/done state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "type": "string", "enum": ["todo", "doing", "done"] },
        "dueDate": { "type": "string", "maxLength": 32 },
        "googleTaskId": { "type": "string", "maxLength": 128 },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "title", "status", "dueDate", "googleTaskId", "sortOrder", "createdAt", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Logged live timer, manual, or group study session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 32 },
        "topicId": { "type": "string", "maxLength": 128 },
        "durationMinutes": { "type": "number" },
        "startedAt": { "type": "string", "maxLength": 40 },
        "endedAt": { "type": "string", "maxLength": 40 },
        "source": { "type": "string", "enum": ["timer", "manual", "group"] },
        "groupSessionId": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "courseCode", "topicId", "durationMinutes", "startedAt", "endedAt", "source", "groupSessionId", "note", "createdAt"]
    },
    "NoteOrFile": {
      "title": "NoteOrFile",
      "description": "Student text note or uploaded file metadata (up to 2 GB via Google Drive).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 32 },
        "topicId": { "type": "string", "maxLength": 128 },
        "topicTitle": { "type": "string", "maxLength": 160 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "type": "string", "enum": ["text", "file"] },
        "textContent": { "type": "string", "maxLength": 50000 },
        "originalFilename": { "type": "string", "maxLength": 240 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "sizeBytes": { "type": "number" },
        "storageKey": { "type": "string", "maxLength": 240 },
        "isShared": { "type": "boolean" },
        "driveFileId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "courseCode", "topicId", "topicTitle", "title", "kind", "textContent", "originalFilename", "mimeType", "sizeBytes", "storageKey", "isShared", "driveFileId", "createdAt", "updatedAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Friend-visible study summary strictly excluding grades, CGPA, and email.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "friendCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "weeklyMinutes": { "type": "number" },
        "streakDays": { "type": "number" },
        "weeklyGoalMinutes": { "type": "number" },
        "courseProgress": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "friendCode", "weeklyMinutes", "streakDays", "weeklyGoalMinutes", "courseProgress", "updatedAt"]
    },
    "FriendCodeLookup": {
      "title": "FriendCodeLookup",
      "description": "Direct friend code lookup record for sending invites without listing users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt"]
    },
    "EmailHashLookup": {
      "title": "EmailHashLookup",
      "description": "SHA-256 hashed email lookup for friend invitations without exposing PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "friendCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "friendCode", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Pending, accepted, or declined friend invitation.",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "fromName", "toUid", "toName", "status", "createdAt", "updatedAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Symmetric friendship pair between two students.",
      "type": "object",
      "properties": {
        "uidA": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uidB": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uidA", "uidB", "memberUids", "requestId", "createdAt"]
    },
    "GroupStudySession": {
      "title": "GroupStudySession",
      "description": "Collaborative study session invite and shared session log.",
      "type": "object",
      "properties": {
        "hostUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hostName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "invitedUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseCode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "topicTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "durationMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["invited", "active", "completed"] },
        "participantUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostUid", "hostName", "invitedUid", "courseCode", "topicTitle", "durationMinutes", "status", "participantUids", "createdAt", "updatedAt"]
    },
    "SharedNote": {
      "title": "SharedNote",
      "description": "Notes or file references explicitly shared by a student with their friends.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceNoteId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseCode": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "type": "string", "enum": ["text", "file"] },
        "textContent": { "type": "string", "maxLength": 50000 },
        "originalFilename": { "type": "string", "maxLength": 240 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "sizeBytes": { "type": "number" },
        "storageKey": { "type": "string", "maxLength": 240 },
        "driveFileId": { "type": "string", "maxLength": 128 },
        "allowedFriendUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerName", "sourceNoteId", "courseCode", "title", "kind", "textContent", "originalFilename", "mimeType", "sizeBytes", "storageKey", "allowedFriendUids", "createdAt", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Explicit administrator privilege record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "FeatureFormConfig": {
      "title": "FeatureFormConfig",
      "description": "Admin-managed Google Form configuration for student feature requests.",
      "type": "object",
      "properties": {
        "formId": { "type": "string", "maxLength": 128 },
        "formTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "responderUri": { "type": "string", "maxLength": 500 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["formId", "formTitle", "responderUri", "updatedByUid", "updatedAt"]
    },
    "GlobalAnnouncement": {
      "title": "GlobalAnnouncement",
      "description": "Admin-managed site-wide announcement banner shown to signed-in students.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "maxLength": 600 },
        "tone": { "type": "string", "enum": ["info", "warning", "success"] },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["enabled", "title", "message", "tone", "updatedByUid", "updatedAt"]
    },
    "SystemSettingsConfig": {
      "title": "SystemSettingsConfig",
      "description": "Admin-managed platform controls including maintenance mode, sharing limits, and default goals.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 500 },
        "allowSharedNotes": { "type": "boolean" },
        "maxGroupMembers": { "type": "number" },
        "defaultWeeklyGoalMinutes": { "type": "number" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["maintenanceMode", "maintenanceMessage", "allowSharedNotes", "maxGroupMembers", "defaultWeeklyGoalMinutes", "updatedByUid", "updatedAt"]
    },
    "FeatureRequest": {
      "title": "FeatureRequest",
      "description": "Student feature request submitted to the admin with status tracking.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "authorEmail": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["courses", "timer", "notes", "cgpa", "friends", "workspace", "other"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "planned", "shipped", "declined"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "authorEmail", "category", "title", "description", "status", "adminNote", "createdAt", "updatedAt"]
    },
    "StudyGroup": {
      "title": "StudyGroup",
      "description": "WhatsApp-style Notes & PDF sharing group channel for classmates and friends.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "courseCode": { "type": "string", "maxLength": 32 },
        "groupCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "memberUids": { "type": "array" },
        "lastMessageText": { "type": "string", "maxLength": 300 },
        "lastMessageAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerName", "name", "courseCode", "groupCode", "memberUids", "lastMessageText", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "StudyGroupMessage": {
      "title": "StudyGroupMessage",
      "description": "Message, shared text note, or shared PDF/file inside a StudyGroup.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "type": "string", "enum": ["text", "note", "file"] },
        "text": { "type": "string", "maxLength": 20000 },
        "noteTitle": { "type": "string", "maxLength": 160 },
        "originalFilename": { "type": "string", "maxLength": 240 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "sizeBytes": { "type": "number" },
        "storageKey": { "type": "string", "maxLength": 240 },
        "driveFileId": { "type": "string", "maxLength": 128 },
        "sourceNoteId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "senderUid", "senderName", "kind", "text", "noteTitle", "originalFilename", "mimeType", "sizeBytes", "storageKey", "sourceNoteId", "createdAt"]
    },
    "GroupCodeLookup": {
      "title": "GroupCodeLookup",
      "description": "Direct group invite code lookup without exposing group listings.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "groupName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "groupName", "ownerUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only student settings and PII."
    },
    "/users/{userId}/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Owner-only courses and private grades."
    },
    "/users/{userId}/topics/{topicId}": {
      "schema": { "$ref": "#/entities/SyllabusTopic" },
      "description": "Owner-only syllabus topics."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Owner-only study sessions."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/NoteOrFile" },
      "description": "Owner-only notes and uploaded file metadata."
    },
    "/userPublicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Friend-visible weekly minutes, streak, and syllabus progress (never grades/CGPA)."
    },
    "/friendCodes/{code}": {
      "schema": { "$ref": "#/entities/FriendCodeLookup" },
      "description": "Direct friend code lookup document."
    },
    "/emailLookup/{emailHash}": {
      "schema": { "$ref": "#/entities/EmailHashLookup" },
      "description": "Direct SHA-256 email hash lookup for friend invites."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend invitations between students."
    },
    "/friendships/{pairId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Symmetric friendship records."
    },
    "/groupSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/GroupStudySession" },
      "description": "Collaborative group study sessions and invites."
    },
    "/sharedNotes/{sharedNoteId}": {
      "schema": { "$ref": "#/entities/SharedNote" },
      "description": "Notes and file metadata explicitly shared with friends."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Explicit admin roles (alongside verified support_email bootstrap)."
    },
    "/appConfig/{configId}": {
      "schema": { "$ref": "#/entities/FeatureFormConfig" },
      "description": "Admin-managed Google Form settings readable by signed-in students."
    },
    "/featureRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FeatureRequest" },
      "description": "Student feature requests triaged by admin."
    },
    "/groupCodes/{code}": {
      "schema": { "$ref": "#/entities/GroupCodeLookup" },
      "description": "Direct group invite code lookup document."
    },
    "/studyGroups/{groupId}": {
      "schema": { "$ref": "#/entities/StudyGroup" },
      "description": "Notes & PDF sharing group channels."
    },
    "/studyGroups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/StudyGroupMessage" },
      "description": "Real-time messages, notes, and PDF attachments inside a study group."
    }
  }
}
